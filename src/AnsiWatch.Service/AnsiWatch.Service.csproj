<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!--
      net8.0 (niet net8.0-windows) zodat de service ook op Linux/CI gebouwd en integratie-getest kan worden.
      Windows-specifieke onderdelen (Event Log, Windows Service-host) zijn met OperatingSystem.IsWindows() afgeschermd.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>AnsiWatch.Service</AssemblyName>
    <RootNamespace>AnsiWatch.Service</RootNamespace>
    <UserSecretsId>dotnet-AnsiWatch.Service-5d1c6c1e</UserSecretsId>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1711</NoWarn>
    <ApplicationIcon Condition="Exists('..\..\assets\ansiwatch.ico')">..\..\assets\ansiwatch.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Publiceren: self-contained, win-x64, single-file (geen .NET-runtime nodig op de doelmachine). -->
  <PropertyGroup Condition=" '$(RuntimeIdentifier)' == 'win-x64' ">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="System.Diagnostics.EventLog" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.EventLog" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AnsiWatch.Core\AnsiWatch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AnsiWatch.Tests" />
  </ItemGroup>

</Project>
